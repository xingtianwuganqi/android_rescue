<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="15dp" android:saveEnabled="false">
    <com.makeramen.roundedimageview.RoundedImageView android:id="@+id/head_img" android:layout_width="40dp" android:layout_height="40dp" android:scaleType="centerCrop" app:riv_oval="true" android:contentDescription="用户头像"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
    <TextView android:id="@+id/nick_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/color_title"
        app:layout_constraintStart_toEndOf="@id/head_img" app:layout_constraintEnd_toStartOf="@id/more_btn" app:layout_constraintTop_toTopOf="@id/head_img" />
    <ImageButton android:id="@+id/more_btn" android:layout_width="48dp" android:layout_height="40dp" android:padding="14dp" android:src="@drawable/icon_detail_more" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="更多操作"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />
    <LinearLayout android:id="@+id/find_pet_tag_row" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="@id/nick_name" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/nick_name">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="想领养 " android:textColor="@color/black" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/tag_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="4dp" android:textSize="16sp" android:textColor="@color/white" android:background="@color/color_system" />
    </LinearLayout>
    <TextView android:id="@+id/content" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/color_content" android:textSize="16sp" android:lineSpacingExtra="4dp"
        app:layout_constraintStart_toStartOf="@id/nick_name" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/find_pet_tag_row" />
    <TextView android:id="@+id/expand_content" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="32dp" android:gravity="center_vertical" android:textColor="@color/color_system" android:textSize="14sp" android:text="展开"
        app:layout_constraintStart_toStartOf="@id/nick_name" app:layout_constraintTop_toBottomOf="@id/content" />
    <com.google.android.material.button.MaterialButton android:id="@+id/find_contact" style="@style/FindPetActionButton"
        android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="40dp" android:layout_marginTop="6dp" android:text="获取TA的联系方式" app:backgroundTint="#FFBE49" app:cornerRadius="5dp"
        app:layout_constraintStart_toStartOf="@id/nick_name" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/expand_content" />
    <TextView android:id="@+id/time_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="12sp" android:textColor="@color/color_desc"
        app:layout_constraintStart_toStartOf="@id/nick_name" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/find_contact" />
    <com.google.android.flexbox.FlexboxLayout android:id="@+id/find_pet_action_row" android:layout_width="0dp" android:layout_height="wrap_content" app:flexWrap="wrap" app:justifyContent="space_between"
        app:layout_constraintStart_toStartOf="@id/nick_name" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/time_text">
        <com.google.android.material.button.MaterialButton android:id="@+id/like_button" style="@style/FindPetTextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" app:icon="@drawable/icon_zan_un" android:text="点赞" />
        <com.google.android.material.button.MaterialButton android:id="@+id/collect_button" style="@style/FindPetTextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" app:icon="@drawable/icon_collection_un" android:text="收藏" />
        <com.google.android.material.button.MaterialButton android:id="@+id/comment_button" style="@style/FindPetTextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" app:icon="@drawable/icon_sh_commen" android:text="评论" />
    </com.google.android.flexbox.FlexboxLayout>
    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_marginTop="4dp" android:background="@color/color_eee"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/find_pet_action_row" app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
