<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginBottom="12dp"
    android:background="@drawable/adoption_card_background" android:foreground="?attr/selectableItemBackground" android:orientation="vertical" android:padding="16dp" android:saveEnabled="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/recommendation_status" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/color_system" android:textSize="13sp" />
        <TextView android:id="@+id/recommendation_unread" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="未读" android:textColor="@color/color_red" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center_vertical">
        <com.makeramen.roundedimageview.RoundedImageView android:id="@+id/recommendation_photo" android:layout_width="76dp" android:layout_height="76dp" android:scaleType="centerCrop" app:riv_corner_radius="8dp" android:importantForAccessibility="no" />
        <TextView android:id="@+id/recommendation_content" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:textColor="@color/black" android:textSize="16sp" android:maxLines="3" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:id="@+id/recommendation_city" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/color_desc" android:textSize="13sp" />
    <TextView android:id="@+id/recommendation_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/color_desc" android:textSize="12sp" />
</LinearLayout>
