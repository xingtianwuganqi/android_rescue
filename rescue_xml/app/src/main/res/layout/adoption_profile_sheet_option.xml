<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/option_row"
    android:layout_width="match_parent"
    android:layout_height="47dp"
    android:background="@drawable/adoption_profile_sheet_option_background"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">

    <TextView
        android:id="@+id/option_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:includeFontPadding="false"
        android:textColor="@color/adoption_profile_sheet_text"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/option_check"
        android:layout_width="17dp"
        android:layout_height="17dp"
        android:layout_marginStart="12dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_adoption_check"
        android:tint="@color/adoption_profile_icon_tint"
        android:visibility="gone" />
</LinearLayout>
