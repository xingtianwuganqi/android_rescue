<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:saveEnabled="false">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="未读提醒" android:textSize="18sp" android:padding="8dp" />
    <ProgressBar android:id="@+id/adoption_reminder_loading" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center_horizontal" android:visibility="gone" />
    <TextView android:id="@+id/adoption_reminder_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="12dp" android:textColor="@color/color_desc" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/adoption_reminder_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" android:saveEnabled="false" />
    <Button android:id="@+id/adoption_reminder_retry" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="提醒加载失败，点击重试" android:visibility="gone" />
    <Button android:id="@+id/adoption_reminder_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="加载更多提醒" android:visibility="gone" />
    <LinearLayout android:id="@+id/adoption_filters" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" />
    <TextView android:id="@+id/adoption_list_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:text="申请时资料 · 用户填写" />
    <ProgressBar android:id="@+id/adoption_list_loading" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center_horizontal" android:visibility="gone" />
    <TextView android:id="@+id/adoption_list_empty" android:layout_width="match_parent" android:layout_height="140dp" android:gravity="center" android:text="暂无数据\n请点击重试" android:textSize="@dimen/address_font" android:textColor="@color/color_desc" android:visibility="gone" />
    <TextView android:id="@+id/adoption_list_error" android:layout_width="match_parent" android:layout_height="140dp" android:gravity="center" android:textSize="@dimen/address_font" android:textColor="@color/color_desc" android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/adoption_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" android:saveEnabled="false" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/adoption_refresh" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="刷新" />
        <Button android:id="@+id/adoption_more" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="加载更多" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
