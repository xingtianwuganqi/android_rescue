<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="FindPetActionButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/color_system</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">10dp</item>
    </style>
    <style name="FindPetTextButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/color_node</item><item name="iconTint">@null</item>
        <item name="iconSize">18dp</item><item name="iconPadding">4dp</item><item name="android:minWidth">0dp</item>
        <item name="android:paddingHorizontal">8dp</item><item name="android:textSize">13sp</item>
    </style>
    <color name="find_pet_manage_entry_background">#FFF0D6</color>
    <style name="FindPetManageEntryButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/find_pet_manage_entry_background</item>
        <item name="android:textColor">@color/color_vip</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="elevation">0dp</item>
        <item name="icon">@drawable/icon_find_right</item>
        <item name="iconGravity">textEnd</item>
        <item name="iconTint">@null</item>
        <item name="iconSize">13dp</item>
        <item name="iconPadding">4dp</item>
    </style>
</resources>
