    <string name="adoption_profile_city_error">请选择城市 / 区县</string>
    <string name="adoption_profile_housing_error">请选择住房情况</string>
    <string name="adoption_profile_employment_error">请选择工作状态</string>
    <string name="adoption_profile_select_province">选择省份</string>
    <string name="adoption_profile_select_city">选择城市</string>
    <string name="adoption_profile_select_district">选择区县</string>

    <style name="AdoptionProfileSectionTitle">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/adoption_profile_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="AdoptionProfileFieldLabel">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/adoption_profile_secondary</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="AdoptionProfileHint">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/adoption_profile_faint</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="AdoptionProfileError">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/adoption_profile_error</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="AdoptionProfileSelectValue">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/adoption_profile_ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="AdoptionProfileSelectSub">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/adoption_profile_faint</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="AdoptionProfilePill">
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">7dp</item>
        <item name="android:paddingEnd">7dp</item>
        <item name="android:minHeight">20dp</item>
    </style>
</resources>
